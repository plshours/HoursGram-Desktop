using "ui/basic.style";
using "settings/settings.style";

// A settings row inside a box: the box is boxBg, so a row that kept the
// windowBg of the settings page would stand out as a band.
hoursgramPaletteButton: SettingsButton(settingsButtonNoIcon) {
	textBg: boxBg;
}
