using "ui/basic.style";
using "ui/widgets/widgets.style";

// HORUSGRAM_DESIGN.md: the icon set of HorusGram, drawn on a round graphite
// plate in the settings. Made by tools/make_icons.py.
hoursgramIconPlate: windowBgRipple;

// HORUSGRAM_DESIGN.md: with Graphite the groups of settings are cards with
// a soft rounded outline, the way the details of a gift are shown.
hoursgramSettingsCardMargin: margins(12px, 0px, 12px, 0px);
hoursgramSettingsCardPadding: margins(4px, 4px, 4px, 4px);
hoursgramSettingsCardRadius: 16px;
hoursgramSettingsCardSkip: 12px;
hoursgramSettingsCardBorder: windowBgRipple;
hoursgramIconFg: windowFg;

hoursgramIconAccount: icon {{ "hoursgram/settings_account", hoursgramIconFg }};
hoursgramIconPrivacy: icon {{ "hoursgram/settings_privacy", hoursgramIconFg }};
hoursgramIconNotifications: icon {{ "hoursgram/settings_notifications", hoursgramIconFg }};
hoursgramIconMoney: icon {{ "hoursgram/settings_money", hoursgramIconFg }};
hoursgramIconChats: icon {{ "hoursgram/settings_chats", hoursgramIconFg }};
hoursgramIconFolders: icon {{ "hoursgram/settings_folders", hoursgramIconFg }};
hoursgramIconSound: icon {{ "hoursgram/settings_sound", hoursgramIconFg }};
hoursgramIconBattery: icon {{ "hoursgram/settings_battery", hoursgramIconFg }};
hoursgramIconAdvanced: icon {{ "hoursgram/settings_advanced", hoursgramIconFg }};
hoursgramIconLanguage: icon {{ "hoursgram/settings_language", hoursgramIconFg }};
hoursgramIconGhost: icon {{ "hoursgram/settings_ghost", hoursgramIconFg }};
hoursgramIconFilters: icon {{ "hoursgram/settings_filters", hoursgramIconFg }};
hoursgramIconAppearance: icon {{ "hoursgram/settings_appearance", hoursgramIconFg }};
hoursgramIconPlugins: icon {{ "hoursgram/settings_plugins", hoursgramIconFg }};
hoursgramIconMusic: icon {{ "hoursgram/settings_music", hoursgramIconFg }};
hoursgramIconGifts: icon {{ "hoursgram/settings_gifts", hoursgramIconFg }};
hoursgramIconMore: icon {{ "hoursgram/settings_more", hoursgramIconFg }};
hoursgramIconDevices: icon {{ "hoursgram/settings_devices", hoursgramIconFg }};

// The Saved and Music buttons of the left bar, in the size of the folder
// icons. Made by tools/make_icons.py --side-bar.
hoursgramSideBarSaved: icon {{ "hoursgram/sidebar_saved", sideBarIconFg }};
hoursgramSideBarSavedActive: icon {{ "hoursgram/sidebar_saved", sideBarIconFgActive }};
hoursgramSideBarMusic: icon {{ "hoursgram/sidebar_music", sideBarIconFg }};
hoursgramSideBarMusicActive: icon {{ "hoursgram/sidebar_music", sideBarIconFgActive }};

// Motion of HorusGram: how far things travel while they appear.
hoursgramMessageAppearShift: 34px;
